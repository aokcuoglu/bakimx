{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "vercel@claude-plugins-official": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/flow/claude-brief.ts\"",
            "timeout": 30,
            "statusMessage": "BakımX akış özeti yükleniyor"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/flow/claude-guard.ts\"",
            "timeout": 20,
            "statusMessage": "akış koruması kontrol ediliyor"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/harness/post-edit-check.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
