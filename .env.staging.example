# Staging environment — copy to .env.staging on the VPS at /opt/bakimx-staging and fill.
# MUST differ from prod: own DB creds, own SESSION_SECRET, staging-scoped cookie.

# Postgres (staging db container)
POSTGRES_USER=bakimx_staging
POSTGRES_PASSWORD=__set_a_strong_password__
POSTGRES_DB=bakimx_staging
DATABASE_URL=postgresql://bakimx_staging:__set_a_strong_password__@db:5432/bakimx_staging

# Auth — DISTINCT from prod so staging cookies never validate on prod and vice-versa
SESSION_SECRET=__set_a_distinct_32+_char_secret__
SESSION_COOKIE_NAME=bakimx_session_staging
SESSION_COOKIE_DOMAIN=staging.app.bakimx.com

NODE_ENV=production

# Public origin used in e-mail links (CTA buttons) AND the e-mail logo URL.
# If unset it falls back to http://localhost:3000 → broken "Giriş Yap" links and
# a logo that won't load. Must be the staging host.
APP_URL=https://staging.app.bakimx.com

# Admin console — same as prod: if unset, /admin 404s for everyone.
# Set to the e-mail you'll log into staging with.
ADMIN_EMAILS=alpkaan@bakimx.com,emre@bakimx.com,hey@bakimx.com

# Transactional e-mail (registration-received + approval/rejection mails).
# If EMAIL_PROVIDER is unset it defaults to "mock": sends NOTHING and only writes a
# CommunicationLog row with provider=mock,status=sent — so approvals look fine but no
# mail ever arrives. Set these to actually send on staging. Domain bakimx.com is already
# verified in Resend, so the prod RESEND_API_KEY works here too. NOTE: with real send on,
# every staging test approval/registration e-mails a REAL address — use one you control.
EMAIL_PROVIDER=resend
RESEND_API_KEY=__same_as_prod_or_a_staging_key__
RESEND_FROM_EMAIL=hey@bakimx.com
RESEND_FROM_NAME=BakimX

# Ruhsat OCR — MVP: Claude Vision (Sonnet 5), app içinde, sidecar yok.
# ANTHROPIC_API_KEY olmadan OCR 500 döner. Bir sonraki dev push'tan ÖNCE doldur.
# Model override opsiyonel: daha ucuz/hızlı ama daha az doğru için OCR_MODEL=claude-haiku-4-5.
OCR_PROVIDER=anthropic
OCR_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=__set_an_anthropic_api_key__

# ...plus any other vars present in .env.production (S3/MinIO, etc.) — staging-scoped.

# TAMI sanal POS — GERÇEK üye iş yeri (production endpoint). Altı alandan biri bile boşsa
# mock istemciye düşer (ödeme sahte olur). DİKKAT: TAMI_ENV=production olduğu için staging
# testlerinde gerçek karta 1 TL ön provizyon çekilir. Değerler TAMI merchant portalından.
TAMI_ENV=production
TAMI_MERCHANT_NUMBER=CHANGE_ME_MERCHANT_NO
TAMI_TERMINAL_NUMBER=CHANGE_ME_TERMINAL_NO
TAMI_SECRET_KEY=CHANGE_ME_SECURITY_KEY
TAMI_JWK_KID=CHANGE_ME_JWK_KID
TAMI_JWK_KEY=CHANGE_ME_JWK_K_VALUE
