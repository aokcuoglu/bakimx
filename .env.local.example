# localhost:3000 — landing ürün asistanı QA ayarları
# Landing ürün asistanını yerelde gerçek sağlayıcıyla denemek için bu dosyayı
# `.env.local` adıyla kopyalayın; gerçek anahtarı yalnız o ignored
# dosyaya yazın. Secret'ı commit etmeyin.
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=your-anthropic-api-key
LANDING_ASSISTANT_AI=on

# Diğer zorunlu yerel değerler için `.env.example` dosyasını temel alın.
