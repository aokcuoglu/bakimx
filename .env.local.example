# localhost:3000 — gerçek AI parça araması QA ayarları
# Bu dosyayı `.env.local` adıyla kopyalayın; gerçek anahtarı yalnız o ignored
# dosyaya yazın. Secret'ı commit etmeyin.
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=your-anthropic-api-key
# Local geliştirmede yoksa SESSION_SECRET'tan ayrı bir anahtar türetilir.
# MARKET_RESEARCH_CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Diğer zorunlu yerel değerler için `.env.example` dosyasını temel alın.
