# ──────────────────────────────────────────────
# Local Development (docker-compose.local.yml)
# ──────────────────────────────────────────────
# Run: docker compose -f docker-compose.local.yml up -d
# Then copy the local block below into .env.local

# --- Local PostgreSQL (OrbStack / Docker) ---
DATABASE_URL="postgresql://bakimx:bakimx@localhost:5432/bakimx"
DIRECT_URL="postgresql://bakimx:bakimx@localhost:5432/bakimx"

# --- Local MinIO (S3-compatible, OrbStack / Docker) ---
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=bakimx
S3_SECRET_ACCESS_KEY=bakimx-dev-secret
S3_BUCKET=bakimx-media
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_DOMAIN is omitted locally — presigned URLs are used instead

# ──────────────────────────────────────────────
# Remote / Supabase (alternative to local)
# ──────────────────────────────────────────────
# DATABASE_URL="postgresql://postgres.USER:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.USER:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"
# Public app origin — e-posta linkleri (/login, /admin), portal linkleri VE TAMI 3DS
# callback'i (`${APP_URL}/api/payments/tami/callback`, bankaya bildirilen dönüş adresi)
# bundan üretilir.
APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# Storage Provider
# ──────────────────────────────────────────────
# mock  — in-memory, files lost on restart (default, zero setup)
# s3    — MinIO (local) or Cloudflare R2 (production)
# STORAGE_PROVIDER=mock

# Cloudflare R2 (required when STORAGE_PROVIDER=s3 in production)
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_BUCKET=bakimx-media
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_DOMAIN=pub-YOUR_HASH.r2.dev

# ──────────────────────────────────────────────
# OCR Provider — mock (default), anthropic, or openai
# ──────────────────────────────────────────────
# When set to "mock" or empty, the system returns demo registration data.
# "anthropic" (MVP standard) = Claude Vision: structured extraction straight from
# the image, in-app, no sidecar. Needs ANTHROPIC_API_KEY.
# The old "paddle"/"hybrid" providers were retired in 2026-07 along with the
# PaddleOCR Python sidecar (ocr-service/); setting either now fails fast with a
# message telling you to switch to anthropic.
OCR_PROVIDER=mock

# Claude Vision (Anthropic) — required for OCR_PROVIDER=anthropic.
# OCR_MODEL defaults to claude-sonnet-5; use claude-haiku-4-5 for cheaper/faster.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OCR_MODEL=claude-sonnet-5

# OpenAI OCR (requires OCR_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_OCR_MODEL=gpt-4o
# OCR_MODEL=gpt-4o

# ──────────────────────────────────────────────
# AI Service Advisor Provider — mock (default), anthropic, or openai
# ──────────────────────────────────────────────
# When set to "mock" or empty, the system returns demo suggestions.
# To use real AI, set to "anthropic" (recommended) or "openai" and provide
# the corresponding API key. AI_MODEL is optional (defaults apply).
AI_PROVIDER=mock

# Landing ask bar AI answer — off (default) or on. When off, the browser makes
# no AI request and uses the deterministic prepared-answer matcher.
LANDING_ASSISTANT_AI=off

# AI Model — override the default model for the selected provider.
# Examples: claude-haiku-4-5 (anthropic, default), gpt-4o-mini (openai, default)
# AI_MODEL=

# Anthropic / Claude AI Advisor (requires AI_PROVIDER=anthropic)
# Uses ANTHROPIC_API_KEY (shared with the ruhsat OCR vision provider)
# AI_MODEL=claude-haiku-4-5

# OpenAI AI Advisor (requires AI_PROVIDER=openai)
# Uses OPENAI_API_KEY (shared with OCR if OCR_PROVIDER=openai)
# AI_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────
# GetirBakım stok/fiyat okuma — mock (default) or http  (BAK-183)
# ──────────────────────────────────────────────
# Aranan bir parçanın GetirBakım'daki stok/fiyat bilgisini okur. "mock" veya boş
# iken demo veri döner ve HİÇBİR dış çağrı yapılmaz. "http" seçilse bile anahtar
# ya da URL eksikse sessizce mock'a düşülür (uyarı loglanır) — eksik ortam
# değişkeni atölyenin parça arama ekranını düşürmemeli.
GETIRBAKIM_PROVIDER=mock

# GetirBakım partner API anahtarı ve taban adresi (GETIRBAKIM_PROVIDER=http için).
# Anahtar GetirBakım tarafındaki PARTNER_API_KEYS listesinden gelir; oradaki
# CRON_SECRET ile HİÇBİR ilgisi yoktur ve onunla değiştirilemez.
# GETIRBAKIM_API_KEY=
# GETIRBAKIM_API_URL=https://getirbakim.com

# Dış çağrı zaman aşımı (ms). Varsayılan 4000, alt sınır 500, üst sınır 15000.
# GETIRBAKIM_TIMEOUT_MS=4000

# ──────────────────────────────────────────────
# VIN → TecDoc araç tanıma — mock (default) or rapidapi
# ──────────────────────────────────────────────
# Resolves a ruhsat VIN to the local vehicle catalog (brand/model/engine
# variant) via the paid RapidAPI auto-parts-catalog service. Responses are
# cached in the vin_lookups table so each VIN is billed at most once.
# "mock" answers the fixture VIN WF0MXXGCHMRT73173 with demo FOCUS data.
VIN_PROVIDER=mock

# RapidAPI key (required when VIN_PROVIDER=rapidapi or TECDOC_PROVIDER=rapidapi)
# RAPIDAPI_KEY=your-rapidapi-key

# Araca uygun parça kataloğu (iş emri Parça sekmesi) — mock (default) or rapidapi.
# Shares RAPIDAPI_KEY and the monthly cap with the VIN lookup; every response is
# cached in tecdoc_cache so each (vehicle, category) is billed at most once.
TECDOC_PROVIDER=mock

# Shared monthly cap on billed RapidAPI calls, VIN + catalog combined
# (plan allows 20000; default 18000). VIN_LOOKUP_MONTHLY_CAP is the legacy alias.
# RAPIDAPI_MONTHLY_CAP=18000

# ──────────────────────────────────────────────
# Communication Providers
# ──────────────────────────────────────────────

# SMS Provider — mock (default) or netgsm
SMS_PROVIDER=mock

# Netgsm SMS (required when SMS_PROVIDER=netgsm)
# NETGSM_USERCODE=your-netgsm-usercode
# NETGSM_PASSWORD=your-netgsm-password
# NETGSM_SENDER=BAKIMX
# NETGSM_API_URL=https://api.netgsm.com.tr/sms/send/get

# WhatsApp Provider — mock (default) or business
WHATSAPP_PROVIDER=mock

# WhatsApp Business API (required when WHATSAPP_PROVIDER=business)
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_ACCESS_TOKEN=your-access-token
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# E-posta sağlayıcı: mock | gmail | resend
EMAIL_PROVIDER=mock

# Gmail SMTP (EMAIL_PROVIDER=gmail iken gerekli)
# GMAIL_USER=hey@bakimx.com
# GMAIL_APP_PASSWORD=            # Google App Password (16 hane, boşluksuz). 2-Step Verification açık olmalı.
# EMAIL_FROM_NAME=BakimX

# Resend Email (required when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=no-reply@bakimx.com
# RESEND_FROM_NAME=BakimX
# RESEND_API_URL=https://api.resend.com/emails

# ──────────────────────────────────────────────
# Cron / Scheduled Jobs
# ──────────────────────────────────────────────

# Secret for cron endpoint authentication (REQUIRED in ALL environments).
# The /api/cron/reminders endpoint returns 500 if this is unset and 401 if the
# Bearer token does not match — it is never publicly accessible.
# Set this to a long random string and send it as the Bearer token.
CRON_SECRET="change-me-to-a-long-random-string"

# Doğrulamasız (kart adımını hiç tamamlamamış) pending workshop süpürmesinin
# legacy sınırı (ISO tarih). Bu tarihten ÖNCE yaratılmış pending kayıtlara asla
# dokunulmaz. Boş/geçersizse koddaki gömülü varsayılan (2026-07-07) kullanılır.
# PROD-MERGE'de gerçek deploy zamanına ayarlanır, bkz DEPLOY.md #9.
# TRIAL_PURGE_CUTOFF="2026-07-07T00:00:00Z"

# ──────────────────────────────────────────────
# Calendar Provider
# ──────────────────────────────────────────────

# Calendar Provider — mock (default) or google
CALENDAR_PROVIDER=mock

# Google Calendar (required when CALENDAR_PROVIDER=google)
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# GOOGLE_CALENDAR_ACCESS_TOKEN=your-access-token
# GOOGLE_CALENDAR_API_URL=https://www.googleapis.com/calendar/v3
# --- Admin console (/admin) ---
# Comma-separated e-mails. TWO roles:
#   1) Bootstrap: while the PlatformAdmin table is empty, these addresses can enter
#      /admin and are written into the table as `founder` on first read. Once the
#      table has rows, membership is managed at /admin/admins and this list is
#      ignored for access. (BAK-93)
#   2) Notification recipients: new sign-up / live-chat e-mails go here.
# If both this list and the PlatformAdmin table are empty, /admin returns 404 for everyone.
ADMIN_EMAILS=

# ──────────────────────────────────────────────
# /admin Google Workspace SSO (OIDC) — BAK-94
# ──────────────────────────────────────────────
# Yalnız /admin konsolu içindir; atölye kullanıcıları /login'den e-posta/şifre
# ile girmeye devam eder. İkisi de boşsa SSO yolu KAPALIDIR: /admin-login
# ekranı düğmeyi göstermez, /api/auth/admin/google/* 404 döner ve durum loglanır.
#
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Kayıtlı redirect URI'lar (birebir):
#   http://localhost:3000/api/auth/admin/google/callback
#   https://app-dev.bakimx.com/api/auth/admin/google/callback
#   https://app.bakimx.com/api/auth/admin/google/callback
# Prod/dev'de değerler SSM + Secrets Manager'dan gelir; repoya YAZILMAZ.
# GOOGLE_OIDC_CLIENT_ID=
# GOOGLE_OIDC_CLIENT_SECRET=
# Kabul edilen Workspace alan adı — kimlik jetonundaki `hd` claim'i bununla
# karşılaştırılır (varsayılan bakimx.com).
# GOOGLE_OIDC_HD=bakimx.com
# Yalnız beklenmedik bir proxy/host kurulumunda: callback URI'yı host'tan
# türetmek yerine sabitler.
# GOOGLE_OIDC_REDIRECT_URI=

# Optional: WhatsApp number (digits only, e.g. 905551112233) used by billing/
# locked-screen "İletişime geç" deep links. If unset, opens generic WhatsApp.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ──────────────────────────────────────────────
# Billing (manual/havale checkout v1)
# ──────────────────────────────────────────────
# Shown on the checkout confirmation screen. Alternative to card payment below.
BILLING_HAVALE_IBAN="TR00 0000 0000 0000 0000 0000 00"
BILLING_HAVALE_ACCOUNT_TITLE="BakımX Yazılım"
BILLING_HAVALE_BANK="Banka adı"

# ──────────────────────────────────────────────
# TAMI sanal POS (kimlik alanlarından herhangi biri boşsa mock kullanılır — yerel geliştirme)
# ──────────────────────────────────────────────
# Kart ödemesi akışı: initiate -> 3DS (bankaya yönlendirme) -> callback -> complete-3ds ->
# otomatik plan aktivasyonu. Kimlik alanlarından biri bile boşsa isTamiConfigured() false
# döner ve factory (src/lib/tami/index.ts) mock istemciye düşer.
TAMI_ENV="sandbox"            # sandbox | production
TAMI_MERCHANT_NUMBER=""
TAMI_TERMINAL_NUMBER=""
TAMI_SECRET_KEY=""
TAMI_JWK_KID=""
TAMI_JWK_KEY=""               # terminal JWK "k" değeri (HS512 imza)
# Sandbox JWK'ları TAMI merchant portalından alınır (mailde gelen zip'teki eski
# JWK'lar değil — portaldan güncel terminal anahtarını indirin).
# NOT: kayıtta 1 TL kart doğrulama (pre-auth3ds + anında cancel) da bu aynı
# kimlik bilgilerini kullanır — bkz. docs/superpowers/specs/2026-07-07-trial-card-verification-design.md
