  serviceOrder   ServiceOrder      @relation(fields: [serviceOrderId], references: [id])
  category       ChecklistCategory @default(inspection)
  description    String
  isCompleted    Boolean           @default(false)
  completedById  String?
  completedBy    Technician?       @relation(fields: [completedById], references: [id])
  completedAt    DateTime?
  note           String?
  sortOrder      Int               @default(0)
  /// Sistem şablonundan gelen madde mi — kapılarda zorunlu sayılır.
  isRequired     Boolean           @default(false)
  /// Şablon maddesinin sabit anahtarı (örn. "inspection.mileage_fuel").
  /// Dolu ⇒ şablondan geldi; seed'in idempotent olmasını sağlar. Serbest maddede null.
  templateKey    String?
  /// Silme SOFT'tur ve YALNIZCA bu iş emrini etkiler: satır mezar taşı olarak
  /// kalır, böylece seed silinen şablon maddesini geri getirmez (`templateKey`
  /// hâlâ "var" sayılır). Yeni iş emirleri şablonun tamamını almaya devam eder.
  /// Okuyan her sorgu `ACTIVE_CHECKLIST_ITEM` ile filtrelemek zorunda.
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?             @relation("ChecklistItemDeletedBy", fields: [deletedById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([workshopId])
  @@index([serviceOrderId])
  @@index([category])
  @@index([isCompleted])
  @@index([deletedAt])
  /// Aynı iş emrine aynı şablon maddesi ikinci kez seed edilemez (eşzamanlı
  /// atama yarışına karşı DB seviyesi koruma). Postgres'te templateKey NULL
  /// olan serbest maddeler bu kısıtla çakışmaz (NULL != NULL).
  @@unique([serviceOrderId, templateKey])
}

