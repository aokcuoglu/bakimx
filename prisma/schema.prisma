  @@index([serviceOrderId])
  @@index([authorId])
  @@index([createdAt])
}

model PartsRequest {
  id             String             @id @default(cuid())
  workshopId     String
  workshop       Workshop           @relation(fields: [workshopId], references: [id])
  serviceOrderId String
  serviceOrder   ServiceOrder       @relation(fields: [serviceOrderId], references: [id])
  requestedById  String?
  requestedBy    Technician?        @relation(fields: [requestedById], references: [id])
  /// Talebin cinsi. BAK-105 öncesi her talep parçadır; DEFAULT part olduğu için
  /// mevcut satırlar backfill'siz doğru değeri alır.
  type           PartsRequestType   @default(part)
  /// Parça talebinde parça adı, dış işçilik talebinde işçiliğin adı
  /// (ör. "Rot balans ayarı"). Tek kolon: talebin geri kalan makinesi
  /// (karar kapısı, iptal, kaleme çevirme) iki tipte de aynı çalışır.
  partName       String
  partSku        String?
  /// Katalogdan seçildiyse parça markası (TecDoc supplier adı); serbest metinde null.
  brand          String?
  /// Katalogdan seçildiyse TecDoc article id — ofis talebi kalemlerken taşınır.
  tecdocArticleId Int?
  quantity       Int                @default(1)
  note           String?
  status         PartsRequestStatus @default(requested)
  /// Dolu ⇒ ofis bu talebi iş emri kalemine çevirdi (kalıcı, geri alınmaz).
  /// `status` fiziksel teslimat akışını (requested→prepared→delivered) izlemeye
  /// devam eder; convertedAt ondan bağımsız, "kaleme çevrildi mi" sorusuna
  /// tek doğru kaynaktır — status tekrar "requested"a dönemeyeceği için ayrı alan gerekir.
  convertedAt    DateTime?
  /// Dolu ⇒ talep karara bağlanarak REDDEDİLDİ (`status = cancelled` ile birlikte
  /// yazılır). `convertedAt` ile birlikte "karar verildi mi" sorusunun iki
  /// yanıtından biridir — ikisi de boşsa talep hâlâ karar bekliyordur ve iş emri
  /// teslime alınamaz (bkz. src/lib/orders/parts-request-guard.ts).
  cancelledAt    DateTime?
  /// İptal gerekçesi — ATÖLYE İÇİ not, müşteri yüzeyine çıkmaz.
  cancelReason   String?
  /// YALNIZ dış işçilikte: teknisyenin bildirdiği tahmini tutar (kuruş, KDV
  /// hariç). Satış fiyatı DEĞİL, atölyenin ödeyeceği maliyet tahminidir; kaleme
  /// çevrilirken ServiceOrderItem.purchasePriceKurus'a taşınır, satış fiyatını
  /// ofis ayrıca girer.
  estimatedPriceKurus Int?
  /// YALNIZ dış işçilikte: işi yapan firma (serbest metin, Supplier kaydı
  /// aranmaz — usta sahada firma kartı açamaz). Kaleme supplierName olarak geçer.
  supplierName   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([workshopId])
  @@index([serviceOrderId])
  @@index([status])
  @@index([requestedById])
}

enum PartsRequestType {
  part
  /// Dışarıya yaptırılan işçilik (rot-balans, şarj dinamosu vb.). Parça değildir:
  /// stok düşümü yapılmaz, katalog/TecDoc alanları boş kalır. Kaleme çevrilince
  /// OrderItemType.external_labor olur.
  external_labor
}

enum PartsRequestStatus {
  requested
  prepared
  delivered
  /// Ofis talebi reddetti (parça alınmayacak). Terminal: kaleme çevrilemez,
  /// fiziksel akışta ilerletilemez; yalnız "geri al" ile `requested`a döner.
  cancelled
}

model LaborSession {
