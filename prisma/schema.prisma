/// Bir iletişim denemesinin kaydı. `workshopId` HER ZAMAN dolu (zorunlu FK), ama
/// bu satırın kiracıya AİT olduğu anlamına gelmez: platform yöneticilerine giden
/// sistem uyarıları da (yeni başvuru bildirimi, TAMI hash/misconfig alarmı, takılı
/// işlem alarmı) ilgili workshop'a bağlanarak loglanır — dedup anahtarı oradan
/// okunur. `internal = true` bu satırların YALNIZ platform tarafına ait olduğunu
/// söyler; kiracıya dönük her sorgu `internal: false` ile filtrelemek ZORUNDADIR
/// (bkz. src/app/(app)/communications/actions.ts). Değeri sendSystemEmail'in
/// zorunlu `audience` alanından gelir, tahminle değil.
model CommunicationLog {
  id           String            @id @default(cuid())
  workshopId   String
  workshop     Workshop          @relation(fields: [workshopId], references: [id])
  type         CommunicationType
  provider     String
  recipient    String
  status       String            @default("pending")
  internal     Boolean           @default(false)
  templateKey  String?
  entityType   String?
  entityId     String?
  providerId   String?
  errorMessage String?
  sentAt       DateTime          @default(now())
  createdAt    DateTime          @default(now())

  @@index([workshopId])
  @@index([type])
  @@index([status])
  @@index([templateKey])
  @@index([entityType, entityId])
  @@index([sentAt])
}

// Persisted result of a background cron run (e.g. "reminders"). The cron route
// returned JSON and forgot — this lets the ops health surface show last-run
// freshness + failures and gate founder alerts. Global (not workshop-scoped).
model CronRun {
  id           String    @id @default(cuid())
  job          String
  status       String    @default("success") // "success" | "error"
  startedAt    DateTime
  finishedAt   DateTime?
  processed    Int       @default(0)
  sent         Int       @default(0)
  failed       Int       @default(0)
  errorMessage String?
  // When a founder alert was sent for this run (debounce handle).
  alertedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([job, startedAt])
}

// Per-tenant feature override. Composes with hasFeature(): an override (not
// expired) wins; otherwise the plan tier is the floor. Lets a founder grant a
// beta/premium feature to one workshop without touching FEATURE_MIN_TIER.
model WorkshopFeatureOverride {
  id         String    @id @default(cuid())
  workshopId String
  workshop   Workshop  @relation(fields: [workshopId], references: [id])
  featureKey String // GatedFeature ("aiAdvisor" | "eInvoice" | "multiBranch" | "rbac") or future "beta_*"
  enabled    Boolean
  reason     String?
  expiresAt  DateTime? // auto-expire (e.g. time-boxed beta grants)
  createdBy  String // founder userId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([workshopId, featureKey])
  @@index([workshopId])
}

/// BakımX PERSONELİNİN `/admin` konsoluna erişimi (BAK-93). Kiracı içi ekip
/// rolleriyle (`UserRole`) karıştırılmamalı — bu tablo platform tarafıdır.
///
/// Üyelik neden DB'de: `ADMIN_EMAILS` env allowlist'iyle personel eklemek/çıkarmak
/// ECS task-def değişikliği + redeploy gerektiriyordu; yani erişimi kesmek en acele
/// edilmesi gereken anda en yavaş yoldu. Env yalnız BOOTSTRAP yolu olarak kaldı:
/// tablo boşken devreye girer ve ilk okumada satırları kendisi yazar (`src/lib/admin.ts`).
///
/// Satır SİLİNMEZ, `disabledAt` ile kapatılır — denetim kaydındaki `actorUserId`
/// bağı ve "kim ne zaman yöneticiydi" sorusunun cevabı korunsun diye.
model PlatformAdmin {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Cascade)

  role AdminRole @default(readonly)

  /// Dolu ise erişim kapalı; açık oturum da bir sonraki istekte reddedilir.
  disabledAt DateTime?

  /// "Tüm oturumlarını kapat" bunu `now()` yapar. Oturum çerezindeki
  /// `authenticatedAt` bundan ESKİYSE oturum reddedilir — iron-session durumsuz
  /// olduğu ve çerez 7 gün yaşadığı için tek iptal noktası budur.
  /// NULL = hiç iptal edilmemiş (bu alan gelmeden önce açılmış oturumlar da geçerli).
  sessionsValidFrom DateTime?

  createdByUserId String?
  createdBy       User?   @relation("PlatformAdminCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([disabledAt])
}

/// Platform yöneticisi rolleri — yetki matrisi `src/lib/admin.ts` içindeki
/// `CAPABILITIES` tablosundadır (kaynak: `docs/operations/platform-admin-model.md` §2).
enum AdminRole {
  founder // Her şey, yönetici yönetimi dahil
  support // Destek: salt-okunur impersonation + canlı destek
  finance // Faturalandırma teyidi + dışa aktarım
  readonly // Yalnız görüntüleme
}

// A founder "login as workshop owner" session. The real admin identity lives in
// the session overlay (never overwritten); this row is the revocation handle +
// audit anchor. Global (target refs are plain ids — no back-relations needed).
model ImpersonationSession {
  id               String    @id @default(cuid())
  adminUserId      String // founder who started it
  targetUserId     String // the (owner) user being impersonated
  targetWorkshopId String
  reason           String?
  readOnly         Boolean   @default(true)
  startedAt        DateTime  @default(now())
  expiresAt        DateTime // hard cap (checked without a DB hit)
  endedAt          DateTime?
  revokedAt        DateTime?

  @@index([adminUserId])
  @@index([targetWorkshopId])
  @@index([expiresAt])
}

model DemoRequest {
  id              String            @id @default(cuid())
  name            String
  businessName    String
  phone           String
  city            String
  monthlyVehicles String
  notes           String?
  clientIp        String?
  status          DemoRequestStatus @default(new)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum DemoRequestStatus {
