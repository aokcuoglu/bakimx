model ServiceOrderItem {
  id                 String           @id @default(cuid())
  workshopId         String
  serviceOrderId     String
  serviceOrder       ServiceOrder     @relation(fields: [serviceOrderId], references: [id])
  type               OrderItemType
  name               String
  sku                String?
  unit               String?
  quantity           Int              @default(1)
  unitPrice          Int? // kuruş
  totalPrice         Int? // kuruş
  partId             String?
  part               PartStockItem?   @relation(fields: [partId], references: [id])
  note               String?
  // Parça markası (TecDoc supplier adı veya serbest). Eski satırlarda marka note'ta kalabilir.
  brand              String?
  // Seçilen yaprak kategori etiketi (örn. "Yağ filtresi").
  category           String?
  // TecDoc kategori düğüm id'si (ileride filtre/rapor için); serbest metin kategoride null.
  categoryId         Int?
  // TecDoc article linkage when the part was picked from the vehicle catalog
  // (no FK — external id). Enables future reorder/OEM cross-reference.
  tecdocArticleId    Int?
  // Kalem bir BakımX katalog ürününden geldiyse o ürünün id'si. FK YOK:
  // fiyat kalemde donmuş bir anlık görüntüdür, ürün kartı sonradan silinse
  // veya pasifleşse bile geçmiş iş emri satırı olduğu gibi kalmalı.
  bakimxProductId    String?
  // Kalemin nasıl eklendiği: katalog akışı mı serbest/manuel mi, yoksa
  // teknisyenin dışarıdan satın aldığı (purchase) parça mı. Yalnız açıklayıcı
  // (rozet + raporlama); eski satırlarda null → rozetsiz.
  source             OrderItemSource?
  // --- Alış fiyatı + dış alım (source=purchase) alanları ---
  // Alış maliyeti (kuruş, KDV HARİÇ). Satış unitPrice'ından bağımsızdır;
  // oluşturmada unitPrice buradan otomatik doldurulur, sonrasında ayrı
  // düzenlenebilir. İki kaynakta dolar:
  //   • source=purchase → teknisyenin firmadan aldığı parçanın fatura tutarı,
  //     aşağıdaki tedarikçi/tarih/fotoğraf alanlarıyla birlikte.
  //   • source=bakimx   → atölyenin BakımX'ten alış fiyatı (bakimx_products
  //     .workshop_price_kurus'un anlık görüntüsü). Tedarikçi alanları BOŞ kalır;
  //     kaynak bakimx_product_id ile bellidir (bkz. src/lib/parts/bakimx-item.ts).
  purchasePriceKurus Int?
  // Tedarikçi adı serbest metin olarak DAİMA yazılır (supplierId seçilse bile)
  // ki liste ekranı join olmadan render edebilsin.
  supplierName       String?
  supplierId         String?
  supplier           Supplier?        @relation(fields: [supplierId], references: [id])
  purchasedAt        DateTime?
  purchasedById      String?
  purchasedBy        Technician?      @relation(fields: [purchasedById], references: [id])
  // --- Teknisyen tamamlama takibi ---
  // Dolu ⇒ kalem sahada yapıldı. Ofis buradan işaretlemez, yalnız görür.
  completedAt        DateTime?
  // Atanmış usta (Technician↔User bağı yok); gerçek kullanıcı AuditLog'a düşer.
  completedById      String?
  completedBy        Technician?      @relation("ItemCompletedBy", fields: [completedById], references: [id])
  // Şu an yazılmıyor/okunmuyor — kalem bazlı teknisyen notu UI'ı için rezerve.
  completionNote     String?
  // Alış anında çekilen parça kutusu fotoğrafı (dahili-yalnız).
  photos             VehiclePhoto[]
  // Satır KDV'ye TABİ mi (BAK-53). Tabi satırların net toplamı, belgenin
  // `taxRate`'iyle Genel Toplam'a eklenen KDV'nin matrahıdır (src/lib/totals.ts).
  // Varsayılan BAK-75'te `true` → `false` çevrildi: KDV kimseye sorulmadan
  // eklenmez, servis tick'i kendisi açar. MEVCUT satırlar değişmez — migration
  // yalnız kolonun DEFAULT'unu değiştirir, hiçbir satırı güncellemez.
  includeVat         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([workshopId])
  @@index([serviceOrderId])
  @@index([partId])
  @@index([workshopId, source])
  @@index([supplierId])
  @@index([serviceOrderId, completedAt])
  @@index([bakimxProductId])
}

