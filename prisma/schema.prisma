  contacted
  qualified
  converted
  archived
}

model SupportRequest {
  id           String               @id @default(cuid())
  name         String
  businessName String
  email        String
  phone        String
  subject      String
  message      String
  clientIp     String?
  status       SupportRequestStatus @default(new)

  /// Şikayeti açan kiracı. Kayıt anında e-posta TEK bir atölyeye eşleşirse
  /// otomatik dolar; birden çok aday çıkarsa NULL kalır ve konsoldan elle
  /// bağlanır — yanlış kiracıya bağlamak, bağsız bırakmaktan pahalıdır.
  workshopId String?
  workshop   Workshop? @relation(fields: [workshopId], references: [id])

  /// Talebi üstlenen BakımX personeli — platform yöneticisinin `User` kaydı.
  assignedToUserId String?
  assignedTo       User?   @relation("SupportRequestAssignee", fields: [assignedToUserId], references: [id])

  /// YALNIZ /admin konsolunda görünen iç not; hiçbir müşteri yüzeyi bu modeli
  /// okumaz. Kaynak taraması: `src/lib/support/internal-note-visibility.test.ts`.
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([workshopId])
  @@index([assignedToUserId])
}

enum SupportRequestStatus {
  new
  in_progress
  resolved
  archived
}

/// www.bakimx.com canlı destek widget'ının tek satırlık yapılandırması.
/// Kiracıya ait DEĞİL — bu, BakımX şirketinin kendi destek masasıdır; bu yüzden
/// workshopId yok ve yönetimi yalnız /admin konsolundan yapılır.
/// `id` sabit "singleton": ikinci bir satır yazılamaz, okuma yolu yoksa oluşturur.
model LiveChatSettings {
  id             String   @id @default("singleton")
  enabled        Boolean  @default(true)
  timezone       String   @default("Europe/Istanbul")
  /// WeeklySchedule — { mon: { enabled, start: "09:00", end: "18:00" }, ... }
  /// Şekli src/lib/live-chat/schedule.ts içindeki parseWeeklySchedule doğrular;
  /// bozuk/eksik JSON sessizce varsayılana düşer (widget asla patlamaz).
  schedule       Json
  /// Kapalı olunacak istisna günler, "YYYY-MM-DD".
  holidays       String[] @default([])
  /// Çevrimiçiyken sohbet açılışına düşen sistem mesajı.
  greeting       String
  /// Çevrimdışıyken sohbet açılışına düşen sistem mesajı.
  offlineMessage String
  /// Panel başlığının altındaki dönüş süresi vaadi.
  responseNote   String
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

/// Bir ziyaretçi ile destek ekibi arasındaki tek bir canlı destek görüşmesi.
/// Ziyaretçinin kimliği `publicToken`dır (oturum yok) — VehiclePassportToken ile
/// aynı desen. Token tarayıcıda localStorage'da durur.
model LiveChatConversation {
  id             String                     @id @default(cuid())
  publicToken    String                     @unique
  status         LiveChatConversationStatus @default(open)
  visitorName    String
  visitorEmail   String
  visitorPhone   String?
  /// Görüşme çalışma saatleri DIŞINDA başladıysa true — gelen kutusunda
  /// "asenkron dönüş bekleniyor" olarak ayırt edilir.
  startedOffline Boolean                    @default(false)
  clientIp       String?
  userAgent      String?
  /// Widget'ın açıldığı sayfa — hangi içeriğin soru doğurduğunu gösterir.
  pageUrl        String?

  lastMessageAt        DateTime  @default(now())
  lastVisitorMessageAt DateTime?
  lastAgentMessageAt   DateTime?
  /// Okundu işaretleri sayaç değil zaman damgasıdır: idempotent, yarış
  /// koşulunda sayacı bozmaz. Okunmamış = lastVisitorMessageAt > agentLastReadAt.
  agentLastReadAt      DateTime?
  visitorLastReadAt    DateTime?
  closedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages     LiveChatMessage[]
  resumeTokens LiveChatResumeToken[]

  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
}

enum LiveChatConversationStatus {
  open
  closed
}

/// Ziyaretçinin e-postadaki bağlantıyla görüşmesine geri dönmesini sağlayan
/// SÜRELİ anahtar (BAK-99).
///
/// NEDEN `publicToken` e-postaya konmuyor: o token görüşmenin kalıcı ve süresiz
/// anahtarıdır. Düz metin olarak e-postaya girerse, o kutuya erişen (ya da
/// iletilen e-postayı gören) herkes görüşmeyi süresiz açar ve iptal etmenin bir
/// yolu olmaz. Bu tablo `PasswordResetToken` ile aynı deseni kurar: yalnız
/// sha256 özeti saklanır, süresi vardır ve iptal edilebilir.
model LiveChatResumeToken {
  id             String               @id @default(cuid())
  conversationId String
  conversation   LiveChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// sha256(ham token), hex. DB sızıntısı çalışan bir bağlantı ÜRETEMEZ.
  tokenHash      String               @unique
  expiresAt      DateTime
  /// Yeni bağlantı üretilince öncekiler iptal edilir — `issuePasswordReset` deseni.
  revokedAt      DateTime?
  /// Bağlantının ilk/son açıldığı an; denetim izi.
  lastUsedAt     DateTime?
  createdAt      DateTime             @default(now())

  @@index([conversationId])
  @@index([expiresAt])
}

model LiveChatMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   LiveChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         LiveChatSender
  /// Yalnız sender=agent iken dolu — hangi yöneticinin yanıtladığı denetim izi.
  agentEmail     String?
  body           String
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

enum LiveChatSender {
  visitor
  agent
  /// Otomatik karşılama / çevrimdışı bilgilendirme metinleri.
  system
}

/// Global TecDoc catalog cache (NOT tenant-scoped), sibling of VinLookup.
/// Rows created this month == billed RapidAPI catalog calls; the monthly cap
/// is shared with vin_lookups (see src/lib/rapidapi-quota.ts).
model TecdocCache {
  key         String   @id // "categories:v2:1:{vehicleId}:23" | "articles:1:{vehicleId}:{categoryId}:23"
  endpoint    String // "categories" | "articles" — observability/quota breakdown
  rawResponse Json
  hitCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([endpoint])
  @@map("tecdoc_cache")
}

/// Normalized TecDoc article rows extracted from cached raw payloads, so repeat
/// queries for the same (vehicleTypeId, categoryId) read from DB rows instead of
/// re-normalizing the raw JSON. Global (NOT tenant-scoped) — catalog reference data.
/// One row per (vehicleTypeId, categoryId, tecdocArticleId). Populated on first
/// API fetch; subsequent reads skip the paid RapidAPI call entirely.
model TecdocArticle {
  id              BigInt   @id @default(autoincrement())
  vehicleTypeId   Int      @map("vehicle_type_id")
  categoryId      Int      @map("category_id")
  tecdocArticleId Int      @map("tecdoc_article_id")
  articleNo       String   @map("article_no")
  productName     String   @map("product_name")
  supplierName    String   @map("supplier_name")
  supplierId      Int?     @map("supplier_id")
  imageUrl        String?  @map("image_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([vehicleTypeId, categoryId, tecdocArticleId])
  @@index([vehicleTypeId, categoryId])
  @@map("tecdoc_articles")
}

/// Bir parçanın OEM (araç üreticisi) referans numaraları — parça detayında zaten
/// gösteriliyordu, arama yapılabilsin diye ayrıca satır olarak saklanır (#312).
/// Global (NOT tenant-scoped) — `tecdoc_articles` gibi katalog referans verisi.
/// Kaynak: `article-detail` yanıtı; detay bir kez faturalanıp kalıcı cache'lendiği
/// için bu tablo ek RapidAPI maliyeti getirmez (bkz. getArticleDetail).
/// Kapsam best-effort: yalnız detayı bir kez getirilmiş parçaların numaraları
/// aranabilir; eski cache satırları `db:backfill-article-oems` ile doldurulur.
model TecdocArticleOem {
  id              BigInt   @id @default(autoincrement())
  tecdocArticleId Int      @map("tecdoc_article_id")
  /// OEM markası ("FORD") — eşleşen numaranın kaynağı olarak gösterilir.
  brand           String
  /// Görüntülenen hâli ("KK2Q-6C301-CA").
  oemNo           String   @map("oem_no")
  /// `normalizePartSearchTerm` ile üretilmiş ayraç/harf duyarsız arama anahtarı
  /// ("kk2q6c301ca") — sorgu tarafı da aynı anahtarı üretir (bkz. lib/tr-search).
  searchKey       String   @map("search_key")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([tecdocArticleId, oemNo])
  @@index([tecdocArticleId])
  @@index([searchKey])
  @@map("tecdoc_article_oems")
}

enum VinLookupStatus {
  found
  not_found
}

/// Global VIN decode cache (NOT tenant-scoped — VIN decoding is universal data).
/// One row == exactly one billed RapidAPI request (transport errors are never
/// cached), so monthly quota usage == count(createdAt >= start of month).
model VinLookup {
  vin         String          @id // normalized: uppercase, 17 chars
  /// VIN model-önek (WMI+VDS = ilk 9 hane) — aynı modelin farklı VIN'leri tek
  /// API çağrısını paylaşsın diye cache bu önekle dedupe edilir (bkz. lookupVin).
  modelKey    String?
  status      VinLookupStatus
  provider    String // "rapidapi" | "mock"
  rawResponse Json? // raw provider payload, null for not_found
  hitCount    Int             @default(1) // cache hits, for observability
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([createdAt])
  @@index([modelKey])
  @@map("vin_lookups")
}

/// Global vehicle catalog (NOT tenant-scoped). Read-only reference data shared
/// by all workshops, imported from the getirbakim database. Source integer IDs
/// are preserved so foreign keys transfer. See scripts/migrate-vehicle-catalog.ts.
model VehicleBrand {
  id     Int            @id
  name   String         @unique
  models VehicleModel[]

  @@map("vehicle_brands")
}

model VehicleModel {
  id       Int           @id
  name     String
  dateFrom String?       @map("date_from")
  dateTo   String?       @map("date_to")
  brandId  Int           @map("brand_id")
  brand    VehicleBrand  @relation(fields: [brandId], references: [id])
  types    VehicleType[]

  @@index([brandId])
  @@index([brandId, name])
  @@map("vehicle_models")
}

model VehicleType {
  id       Int                 @id
  name     String
  cc       Int?
  fuelType String?             @map("fuel_type")
  hp       Int?
  kwt      Int?
  yearFrom String?             @map("year_of_constr_from")
  yearTo   String?             @map("year_of_constr_to")
  modelId  Int                 @map("model_id")
  model    VehicleModel        @relation(fields: [modelId], references: [id])
  details  VehicleTypeDetail[]

  @@index([modelId])
  @@map("vehicle_types")
}

model VehicleTypeDetail {
  id                    BigInt      @id
  vehicleTypeId         Int         @map("vehicle_type_id")
  brakeSystem           String?     @map("brake_system")
  carId                 Int?        @map("car_id")
  ccmTech               Int?        @map("ccm_tech")
  constructionType      String?     @map("construction_type")
  cylinder              Int?
  cylinderCapacityCcm   Int?        @map("cylinder_capacity_ccm")
  cylinderCapacityLiter Int?        @map("cylinder_capacity_liter")
  fuelType              String?     @map("fuel_type")
  fuelTypeProcess       String?     @map("fuel_type_process")
  impulsionType         String?     @map("impulsion_type")
  manuId                Int?        @map("manu_id")
  manuName              String?     @map("manu_name")
  modId                 Int?        @map("mod_id")
  modelName             String?     @map("model_name")
  motorType             String?     @map("motor_type")
  powerHpFrom           Int?        @map("power_hp_from")
  powerHpTo             Int?        @map("power_hp_to")
  powerKwFrom           Int?        @map("power_kw_from")
  powerKwTo             Int?        @map("power_kw_to")
  typeName              String?     @map("type_name")
  typeNumber            Int?        @map("type_number")
  valves                Int?
  yearOfConstrFrom      String?     @map("year_of_constr_from")
  yearOfConstrTo        String?     @map("year_of_constr_to")
  rmiTypeId             Int?        @map("rmi_type_id")
  motorCodes            Json?       @map("motor_codes")
  rawPayload            Json?       @map("raw_payload")
  createdAt             DateTime    @map("created_at")
  updatedAt             DateTime    @map("updated_at")
  type                  VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@index([vehicleTypeId])
  @@map("vehicle_type_details")
}

// ---------------------------------------------------------------------------
// BakımX kendi ürün kataloğu (BAK-30 tasarımı, Faz 1)
//
// Bu bloktaki tabloların hiçbiri `workshopId` TAŞIMAZ — sahibi BakımX'tir ve
// tüm atölyelere aynı satırlar görünür. Üç parça kaynağının ayrımı:
//   - `TecdocArticle`  → ücretli RapidAPI feed'inin salt-okunur önbelleği, araca bağlı
//   - `PartStockItem`  → atölyenin KENDİ stoğu, tenant'a özel
//   - `BakimxProduct`  → BakımX'in kendi ürünü, araçtan bağımsız, fiyat/stoğu bizde
//
// Tenant izolasyonu kuralı burada "her sorguda workshopId" değil, "okuma yolunda
// DAİMA public DTO"dur: `costPriceKurus` ve içe aktarım geçmişi atölye yüzeyine
// asla çıkmaz (bkz. BAK-33).
// ---------------------------------------------------------------------------

/// Ürünün hangi araçlarda listeleneceği.
enum BakimxFitmentScope {
  /// Her araçta (ve araç kataloğa hiç bağlı değilken de) listelenir — Faz 1'in tek değeri.
  universal
  /// Yalnız `bakimx_product_fitments` satırlarındaki araçlarda listelenir — Faz 2.
  vehicle_linked
}

/// İçe aktarım partisinin yazma modu.
enum BakimxImportMode {
  /// Tam ürün kartı (yeni ürün açar, mevcudu tüm alanlarıyla günceller).
  upsert
  /// Yalnız fiyat + stok kolonlarını günceller; ad/açıklama/görsel korunur.
  price_stock_only
}

enum BakimxImportStatus {
  pending
  previewed
  applied
  failed
  cancelled
}

/// Marka bazlı gruplama ("Mutlu", "Petrol Ofisi"...). Bir markanın tüm ürünlerini
/// tek anahtarla pasifleştirebilmek ve fiyat listesini markaya bağlı yükleyebilmek için.
model BakimxProductBrand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products BakimxProduct[]
  imports  BakimxProductImport[]

  @@index([isActive])
  @@map("bakimx_product_brands")
}

/// BakımX'in KENDİ ürün kartı — global (tenant-scoped DEĞİL).
/// Fiyat sözleşmesi: `src/lib/money.ts` (kuruş, tam sayı; lira dönüşümü yalnız UI sınırında).
model BakimxProduct {
  id  String @id @default(cuid())
  /// İçe aktarımın idempotent anahtarı: aynı dosya iki kez yüklenirse ikinci sefer
  /// 0 yeni / N güncelleme üretir (bkz. BAK-34).
  sku String @unique

  name             String
  brandId          String             @map("brand_id")
  brand            BakimxProductBrand @relation(fields: [brandId], references: [id])
  /// Denormalize marka adı — liste/arama join'siz render etsin ve `searchKey`
  /// üretimi tek satırdan beslensin diye ürün kartında da tutulur.
  brandName        String             @map("brand_name")
  /// İç taksonomi yaprağı ("aku", "yag-filtresi"). TecDoc ağacından bağımsız.
  categoryKey      String?            @map("category_key")
  /// Opsiyonel TecDoc kategori köprüsü — dolu ise ürün Faz 2'de TecDoc ağacının
  /// o yaprağında da listelenir.
  tecdocCategoryId Int?               @map("tecdoc_category_id")
  /// Muadil eşleştirme için OEM numaraları (Faz 2). Faz 1'de yalnız `searchKey`'i besler.
  oemNumbers       String[]           @default([]) @map("oem_numbers")
  barcode          String?
  unit             String             @default("adet")
  description      String?
  imageUrl         String?            @map("image_url")
  specsJson        Json?              @map("specs_json")
  /// `normalizePartSearchTerm` ile üretilmiş ayraç/harf duyarsız arama anahtarı:
  /// name + brandName + sku + oemNumbers. Sorgu tarafı da aynı anahtarı üretir
  /// (bkz. src/lib/parts/bakimx-search-key.ts ve src/lib/tr-search.ts).
  /// Ürün araca göre ön-filtrelenemediği için (global katalog) arama bu tek
  /// kolon üzerinden yürür.
  searchKey        String             @map("search_key")

  // --- Fiyat (kuruş; KDV HARİÇ saklanır) ---
  /// Atölyenin BakımX'ten ALIŞ fiyatı, KDV hariç. İş emri kaleminde
  /// `purchasePriceKurus`'a yazılır, `unitPrice` bundan ön-doldurulup atölyenin
  /// kendi marjıyla düzenlenir (bkz. BAK-35).
  workshopPriceKurus Int    @map("workshop_price_kurus")
  /// KDV oranı bps (2000 = %20); fiyat hariç saklandığı için oran ayrı kolonda.
  vatRateBps         Int    @default(2000) @map("vat_rate_bps")
  /// BakımX'in İÇ maliyeti — atölye yüzeyine ASLA çıkmaz, public DTO'ya alınmaz.
  costPriceKurus     Int?   @map("cost_price_kurus")
  currency           String @default("TRY")

  // --- Stok (tek global havuz; depo/şube kırılımı yok) ---
  /// Faz 1'de yalnız BİLGİLENDİRME: kalem eklendiğinde stok düşülmez, rezervasyon
  /// yoktur (gerçek düşüm sipariş/tedarik akışıyla, Faz 2).
  stockQty      Int     @default(0) @map("stock_qty")
  lowStockQty   Int     @default(0) @map("low_stock_qty")
  /// Stok 0 iken de "siparişe açık" gösterilir.
  backorderable Boolean @default(false)
  leadTimeDays  Int?    @map("lead_time_days")

  // --- Görünürlük ---
  fitmentScope BakimxFitmentScope @default(universal) @map("fitment_scope")
  isActive     Boolean            @default(true) @map("is_active")
  publishedAt  DateTime?          @map("published_at")

  /// Ürünü en son yazan içe aktarım partisi (FK yok: parti kaydı arşivlense de
  /// ürün kartı yaşamaya devam eder).
  lastImportId    String?  @map("last_import_id")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fitments BakimxProductFitment[]

  @@index([brandId])
  @@index([isActive, fitmentScope])
  @@index([categoryKey])
  @@index([barcode])
  @@index([searchKey])
  @@index([lastImportId])
  @@map("bakimx_products")
}

/// Ürün ↔ araç tipi bağı — yalnız `fitmentScope = vehicle_linked` ürünler için.
/// Faz 1'de tablo BOŞ kalır; Faz 2'de "bu akü şu motorlara uyar" dendiğinde
/// şema değişikliği gerekmesin diye şimdiden açılır.
/// `vehicleTypeId` FK'sız tutulur — `tecdoc_articles` ile aynı sözleşme: araç
/// kataloğu dışarıdan içe aktarılan referans veridir.
model BakimxProductFitment {
  id            String        @id @default(cuid())
  productId     String        @map("product_id")
  product       BakimxProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleTypeId Int           @map("vehicle_type_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@unique([productId, vehicleTypeId])
  @@index([vehicleTypeId])
  @@map("bakimx_product_fitments")
}

/// Excel/CSV içe aktarım partisi — her yükleme denetlenebilir ve geri izlenebilir
/// (GitHub #211, bkz. BAK-34). Akış: yükle → ön izleme (dry-run) → uygula.
model BakimxProductImport {
  id       String              @id @default(cuid())
  brandId  String?             @map("brand_id")
  brand    BakimxProductBrand? @relation(fields: [brandId], references: [id])
  fileName String              @map("file_name")
  /// Kaynak dosyanın storage anahtarı (src/lib/storage) — parti sonradan denetlenebilsin diye saklanır.
  fileKey  String?             @map("file_key")

  mode   BakimxImportMode   @default(upsert)
  status BakimxImportStatus @default(pending)

  /// Marka fiyat listeleri sık sık KDV DAHİL gelir; işaretliyse değerler
  /// yüklenirken hariçe çevrilir (aksi hâlde katalog `vatRateBps` kadar şişer).
  pricesIncludeVat Boolean @default(false) @map("prices_include_vat")

  totalRows    Int   @default(0) @map("total_rows")
  createdCount Int   @default(0) @map("created_count")
  updatedCount Int   @default(0) @map("updated_count")
  skippedCount Int   @default(0) @map("skipped_count")
  errorCount   Int   @default(0) @map("error_count")
  /// Satır no + hata mesajı; kısmi/sessiz uygulama yok, hatalar kullanıcıya dönülür.
  errorsJson   Json? @map("errors_json")

  createdByUserId String    @map("created_by_user_id")
  appliedAt       DateTime? @map("applied_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@map("bakimx_product_imports")
}

/// Global katalog denetim kaydı.
/// Mevcut `AuditLog` KULLANILAMAZ: `workshopId` zorunlu ve admin tarafındaki
/// katalog değişikliği bir atölyeye ait değil.
model BakimxCatalogAudit {
  id          String @id @default(cuid())
  actorUserId String @map("actor_user_id")
  /// "product" | "brand" | "import"
  entityType  String @map("entity_type")
  entityId    String @map("entity_id")
  /// "create" | "update" | "price_change" | "stock_change" | "import_apply"
  action      String

  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("bakimx_catalog_audit")
}

// ---------------------------------------------------------------------------
// BakımX sipariş TALEBİ akışı (BAK-60, BAK-30 tasarımındaki B seçeneği)
//
// Bu blok yukarıdakilerin AKSİNE tenant'a aittir: sipariş bir atölyenin talebidir,
// katalog satırı gibi herkese açık değildir. Okuma yolu DAİMA `workshopId` ile
// süzülür; yalnız `/admin/catalog/orders` tüm atölyeleri görür.
//
// KALEM ≠ SİPARİŞ: BakımX ürününü iş emrine kalem olarak eklemek (bkz.
// `ServiceOrderItem.bakimxProductId`) burada BİR SATIR AÇMAZ ve stoğa dokunmaz.
// Sipariş yalnız açık bir "Sipariş ver" eylemiyle doğar — atölye bir parçayı
// teklife koyup işi almayabilir, o yüzden kalem eklemek talep sayılmaz.
//
// STOK: `bakimx_products.stock_qty` YALNIZ `shipped` geçişinde düşer (talepte,
// `confirmed`'da ya da kalem eklemede değil) ve tam olarak BİR KEZ düşer —
// geçiş, mevcut durumu koşula alan bir `updateMany` ile transaction içinde
// yapılır (bkz. src/app/admin/catalog/orders/actions.ts). Talep anında
// rezervasyon YOKTUR: iki atölye aynı 3 adetlik ürünün 3'ünü birden isteyebilir,
// admin bunu sevkiyattan önce listedeki uyarıda görür.
// ---------------------------------------------------------------------------

/// Sipariş yaşam döngüsü. İptal yalnız `shipped` ÖNCESİNDE mümkündür ve stoğa
/// hiç dokunmaz; `shipped` ve `cancelled` terminal durumlardır.
enum BakimxOrderStatus {
  requested
  confirmed
  shipped
  cancelled
}

/// Atölyenin BakımX'e verdiği sipariş talebi.
model BakimxOrder {
  id         String   @id @default(cuid())
  workshopId String   @map("workshop_id")
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  /// Talebi açan kullanıcı. FK YOK — `bakimx_product_imports.created_by_user_id`
  /// ile aynı sözleşme: kullanıcı silinse de sipariş geçmişi yaşar.
  createdByUserId String @map("created_by_user_id")

  status BakimxOrderStatus @default(requested)
  note   String?

  confirmedAt DateTime? @map("confirmed_at")
  shippedAt   DateTime? @map("shipped_at")
  cancelledAt DateTime? @map("cancelled_at")

  items BakimxOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workshopId, status])
  @@index([status, createdAt])
  @@map("bakimx_orders")
}

/// Sipariş kalemi — talep ANININ donmuş görüntüsü.
///
/// Ad/SKU ve üç fiyat alanı bilinçli olarak kopyalanır: ürün kartı sonradan
/// değişse (zam, isim düzeltmesi, yayından kalkma) geçmiş sipariş ne istendiğini
/// ve o gün hangi tutara istendiğini göstermeye devam etmeli. Bu yüzden
/// `bakimxProductId` de FK DEĞİLDİR (`ServiceOrderItem.bakimxProductId` ile aynı
/// sözleşme).
model BakimxOrderItem {
  id      String      @id @default(cuid())
  orderId String      @map("order_id")
  order   BakimxOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  bakimxProductId String @map("bakimx_product_id")
  quantity        Int

  /// Sunucuda çözülmüş, iskonto UYGULANMIŞ birim fiyat — KDV hariç, kuruş.
  /// İstemcinin gönderdiği fiyat hiçbir koşulda buraya yazılmaz.
  unitPriceKurus Int @map("unit_price_kurus")
  /// Fiyatın nasıl oluştuğu sonradan açıklanabilsin diye liste fiyatı ve oran da
  /// birlikte donar (`unitPrice = listPrice × (10000 − discountBps) / 10000`).
  listPriceKurus Int @map("list_price_kurus")
  discountBps    Int @map("discount_bps")

  nameSnapshot String @map("name_snapshot")
  skuSnapshot  String @map("sku_snapshot")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([bakimxProductId])
  @@map("bakimx_order_items")
}

/// Süreçler arası paylaşımlı sabit-pencere (fixed window) rate limit sayacı
/// (BAK-116). Bellekteki `Map` her ECS task'ında ayrı bir sayaç tuttuğu için
/// etkin eşik task sayısıyla çarpılıyordu; bu tablo tek gerçek sayacı tutar.
///
/// Satırlar kısa ömürlüdür: `resetAt` geçtikten sonra sayaç sıfırlanır ve
/// `src/lib/rate-limit.ts` süresi dolmuş satırları periyodik olarak siler.
model RateLimitCounter {
  /// Kova anahtarı — ör. `login:203.0.113.7`, `login:acct:email:a@b.com`.
  key   String @id
  count Int
  /// Pencerenin bittiği an; bu andan sonraki ilk istek sayacı 1'e çeker.
  resetAt DateTime

  @@index([resetAt])
}

/// Bir olayın ciddiyeti. `operational` bilerek burada YOK — bu enum yalnız aktif
/// bir sorunu tanımlar; genel durum (`operational` dahil) `deriveOverallStatus`
/// ile açık olay YOKLUĞUNDAN türetilir (bkz. `src/lib/status-page.ts`).
enum StatusIncidentSeverity {
  degraded
  major_outage
}

/// Dahili, ücretsiz public statü sayfasının (BAK-128) kaynağı. `resolvedAt` NULL
/// olan satırlar "aktif" sayılır; genel platform durumu bunların en yüksek
/// ciddiyetinden türetilir. Geçmiş için satır asla silinmez, yalnız çözülür.
model StatusIncident {
  id       String                  @id @default(cuid())
  title    String
  severity StatusIncidentSeverity
  message  String

  /// Yayınlayan yönetici — `PlatformAdmin` değil e-posta: konsol geçmişi
  /// yöneticinin ekipten ayrılmasından sonra da okunabilir kalmalı.
  createdByEmail String @map("created_by_email")

  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resolvedAt])
  @@index([createdAt])
  @@map("status_incidents")
}

/// Web Push aboneliği (BAK-129, Faz B — teknisyen bildirimleri panel KAPALIYKEN).
///
/// Cihaz/tarayıcı başına bir satır: aynı kullanıcının telefonu ve tableti iki
/// ayrı abonelik tutar. `endpoint` push servisinin (FCM / Mozilla / Apple)
/// ürettiği global benzersiz adrestir, bu yüzden gerçek kimlik odur — aynı
/// tarayıcı yeniden abone olduğunda satır GÜNCELLENİR, yenisi açılmaz.
///
/// `workshopId` kullanıcıdan türetilir ama sütun olarak da tutulur: gönderim
/// sorgusu aboneliği tek adımda kiracıya göre daraltabilsin diye (bkz.
/// src/lib/technician/push-dispatch.ts). Kullanıcı silinince abonelik de gider.
model PushSubscription {
  id         String   @id @default(cuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Push servisinin uç adresi — RFC 8030. Global benzersiz.
  endpoint String @unique
  /// RFC 8291 içerik şifreleme anahtarları (`subscription.getKey()`, base64url).
  p256dh String
  auth   String

  /// Tanılama için: aboneliği açan tarayıcı/PWA. Kişisel veri taşımaz.
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workshopId, userId])
  @@index([userId])
}
