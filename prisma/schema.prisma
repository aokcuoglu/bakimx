generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workshop {
  id String @id @default(cuid())
  // Tenant giriş kodu (BAK-40). E-postasız kullanıcı `/w/<loginCode>` ile kendi
  // atölyesini seçer; kullanıcı adları YALNIZ bu tenant içinde benzersizdir.
  // Format: küçük harf `a-z0-9-`, 3–20 karakter (bkz. `src/lib/workshop-code.ts`).
  // v1'de uygulama içinden DEĞİŞTİRİLEMEZ — yazdırılmış QR kartları ölmesin.
  loginCode    String   @unique
  name         String
  phone        String
  city         String
  district     String?
  address      String
  email        String?
  website      String?
  logoUrl      String?
  taxNumber    String?
  taxOffice    String?
  invoiceTitle String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Billing / subscription / onboarding (SaaS) ---
  // Defaults keep existing & admin-provisioned workshops fully active; only the
  // self-serve registration flow overrides these (pending approval + trialing).
  planTier           PlanTier               @default(pro)
  subscriptionStatus SubscriptionStatus     @default(active)
  approvalStatus     WorkshopApprovalStatus @default(approved)
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  // Self-serve upgrade request (manual activation until iyzico billing lands):
  // the workshop picks a package, an admin then activates it via workshop-admin.
  requestedPlanTier  PlanTier?
  planRequestedAt    DateTime?
  // Founder-granted extra login seats beyond the plan tier's included seats
  // (paid overage / custom deals — charged offline until usage billing lands).
  extraSeats         Int                    @default(0)

  // --- BakımX pricing (BAK-47) ---
  // Workshop-level discount applied to all BakımX products (basis points: 0-10000, 2000 = 20%).
  bakimxDiscountBps  Int                    @default(0)

  // --- Paid subscription period (manual/havale billing v1) ---
  // Set on the first confirmed paid order. Null = legacy/admin-provisioned or
  // never-paid workshop (no period gate). currentPeriodEnd < now => locked.
  billingCycle     BillingCycle?
  currentPeriodEnd DateTime?

  settings               WorkshopSettings?
  users                  User[]
  pushSubscriptions      PushSubscription[]
  customers              Customer[]
  vehicles               Vehicle[]
  intakes                VehicleIntakeForm[]
  photos                 VehiclePhoto[]
  damageMarks            DamageMark[]
  approvals              ApprovalRequest[]
  shareLinks             PublicShareLink[]
  timelineEvents         IntakeTimelineEvent[]
  orders                 ServiceOrder[]
  quotes                 Quote[]
  quoteItems             QuoteItem[]
  appointments           Appointment[]
  reminders              MaintenanceReminder[]
  auditLogs              AuditLog[]
  partStockItems         PartStockItem[]
  stockMovements         StockMovement[]
  suppliers              Supplier[]
  partSupplierPrices     PartSupplierPrice[]
  collections            CollectionPayment[]
  ocrLogs                OcrLog[]
  passportTokens         VehiclePassportToken[]
  technicians            Technician[]
  checklistItems         ChecklistItem[]
  internalNotes          InternalNote[]
  partsRequests          PartsRequest[]
  laborSessions          LaborSession[]
  communicationTemplates CommunicationTemplate[]
  communicationLogs      CommunicationLog[]
  calendarSyncLogs       CalendarSyncLog[]
  reminderExecutionLogs  ReminderExecutionLog[]
  invites                Invite[]
  billingOrders          BillingOrder[]
  featureOverrides       WorkshopFeatureOverride[]
  laborCatalogItems      LaborCatalogItem[]
  bakimxOrders           BakimxOrder[]
  vehicleHistoryGrants   VehicleHistoryGrant[]
  supportRequests        SupportRequest[]
}

// Feature/pricing package a workshop is on. During the trial a workshop is
// granted "pro" so it experiences the full value of the paid product.
enum PlanTier {
  starter
  pro
  premium
}

// Billing lifecycle of the workshop's subscription.
enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

// Early-access onboarding gate: self-serve sign-ups start as `pending` and must
// be approved by an admin before they can sign in / start their trial.
enum WorkshopApprovalStatus {
  pending
  approved
  rejected
}

model BillingOrder {
  id               String             @id @default(cuid())
  workshopId       String
  workshop         Workshop           @relation(fields: [workshopId], references: [id])
  type             BillingOrderType
  planTier         PlanTier
  billingCycle     BillingCycle
  amountMinor      Int // kuruş — satın alma anındaki KDV-dahil fiyat snapshot'ı
  currency         String             @default("TRY")
  status           BillingOrderStatus @default(pending_payment)
  method           BillingMethod      @default(havale)
  reference        String             @unique // havale eşleştirme kodu, ör. "BX-7K3Q9"
  billingSnapshot  Json? // o anki ünvan/vergi no/adres → makbuz için
  note             String?
  createdAt        DateTime           @default(now())
  confirmedAt      DateTime?
  confirmedByEmail String?
  periodStart      DateTime?
  periodEnd        DateTime?

  paymentTransactions PaymentTransaction[]

  @@index([workshopId])
  @@index([status])
}

enum BillingCycle {
  monthly
  yearly
}

enum BillingOrderType {
  new_purchase
  upgrade
  renewal
}

enum BillingOrderStatus {
  pending_payment
  confirmed
  cancelled
}

enum BillingMethod {
  havale
  manual
  card
}

// Kartlı ödeme denemesi — bir BillingOrder birden çok deneme alabilir
// (başarısız 3DS → retry). Callback idempotency deneme-başına unique key ister.
// purpose=card_verification denemelerinin billingOrderId'si YOKTUR (kayıtta 1 TL
// kart doğrulaması bir siparişe değil doğrudan workshop'a bağlıdır — bkz. workshopId).
model PaymentTransaction {
  id              String                    @id @default(cuid())
  billingOrderId  String?
  billingOrder    BillingOrder?             @relation(fields: [billingOrderId], references: [id])
  purpose         PaymentTransactionPurpose @default(purchase)
  workshopId      String // denormalize — tenant-scoped admin sorguları için
  provider        String                    @default("tami")
  providerOrderId String                    @unique // TAMI'ye giden orderId (2-36 kar.), deneme başına benzersiz
  status          PaymentTransactionStatus  @default(initiated)
  amountMinor     Int // kuruş snapshot
  currency        String                    @default("TRY")
  maskedPan       String? // SADECE callback'ten gelen maskeli numara
  cardBrand       String?
  errorCode       String?
  errorMessage    String?
  correlationId   String?
  callbackPayload Json? // sanitize edilmiş callback gövdesi (TAMI zaten PAN/CVV dönmez)
  // Kart verisi (PAN/CVV/expiry/holder) ASLA saklanmaz — PCI
  createdAt       DateTime                  @default(now())
  completedAt     DateTime?

  @@index([billingOrderId])
  @@index([workshopId, createdAt])
}

enum PaymentTransactionStatus {
  initiated
  callback_received
  completed
  failed
  expired
}

enum PaymentTransactionPurpose {
  purchase
  card_verification
}

model WorkshopSettings {
  id         String   @id @default(cuid())
  workshopId String   @unique
  workshop   Workshop @relation(fields: [workshopId], references: [id])

  pdfLogoUrl          String?
  publicPortalLogoUrl String?
  passportLogoUrl     String?
  themeColor          String?
  accentColor         String?

  smsProvider         String  @default("mock")
  smsApiKey           String?
  smsSenderName       String?
  whatsappProvider    String  @default("mock")
  whatsappApiKey      String?
  whatsappPhoneNumber String?
  emailProvider       String  @default("mock")
  emailApiKey         String?
  emailFromAddress    String?
  emailFromName       String?

  weekdayStart       String  @default("09:00")
  weekdayEnd         String  @default("18:00")
  weekdayWorkingDays String  @default("1,2,3,4,5")
  weekendStart       String  @default("10:00")
  weekendEnd         String  @default("14:00")
  weekendWorkingDays String  @default("6")
  holidayEnabled     Boolean @default(false)
  holidayDates       String?

  defaultAppointmentDuration Int    @default(60)
  bufferDuration             Int    @default(15)
  reminderTimings            String @default("60,30")

  workOrderTemplate         String?
  servicePassportTemplate   String?
  collectionReceiptTemplate String?

  // Müşteriye giden yüzeylerin alt bilgisinde gösterilen pazarlama / iletişim
  // bilgileri (#173). Hepsi opsiyoneldir; boş olan alan hiçbir yüzeyde satır
  // açmaz. `publicWhatsappNumber`, yukarıdaki `whatsappPhoneNumber` ile aynı
  // şey DEĞİLDİR: o alan sağlayıcının gönderim numarasıdır, bu alan müşteriye
  // gösterilen hattır.
  facebookUrl          String?
  instagramUrl         String?
  xUrl                 String?
  tiktokUrl            String?
  youtubeUrl           String?
  linkedinUrl          String?
  publicWhatsappNumber String?
  faxNumber            String?
  secondaryPhone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workshopId])
}

model User {
  id String @id @default(cuid())
  // BAK-40: e-postasız usta/çırak hesabı açılabilsin diye NULLABLE. Postgres
  // birden çok NULL'a izin verdiği için @unique korunur. `owner`/`manager`
  // rollerinde DOLU olması DB CHECK'i ile zorunlu tutulur.
  email      String?  @unique
  // Tenant içi giriş adı — küçük harfe normalize edilmiş saklanır. Global DEĞİL:
  // her atölyede bir "ahmet" olabilir.
  username   String?
  password   String
  // Sahibin ürettiği geçici şifreyle ilk girişte şifre değiştirmeye zorlar (P1).
  mustChangePassword Boolean @default(false)
  firstName  String?
  lastName   String?
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id])
  // Team/RBAC: default `owner` is backfill-safe — existing/seed users become the
  // workshop owner with no data fixup. Invited users get their role explicitly.
  role       UserRole @default(owner)
  // Soft-disable a seat (blocks sign-in) without deleting history.
  isActive   Boolean  @default(true)
  // BAK-39: Opsiyonel bağ — giriş hesabını personel kaydıyla eşler. Bağlı kullanıcılar
  // teknisyen panelinde kendi işlerini görür; bağsız olanlar listedeki ilk teknisyeni seçer.
  // Bağ kaldırıldığında NULL'a döner; eski davranış korunur (geriye dönük kırılma yok).
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  auditLogs             AuditLog[]
  sentInvites           Invite[]             @relation("InviteCreatedBy")
  passwordResets        PasswordResetToken[]
  deletedPhotos         VehiclePhoto[]       @relation("VehiclePhotoDeletedBy")
  deletedChecklistItems ChecklistItem[]      @relation("ChecklistItemDeletedBy")
  platformAdmin         PlatformAdmin?       @relation("PlatformAdminUser")
  grantedPlatformAdmins PlatformAdmin[]      @relation("PlatformAdminCreatedBy")
  /// Bu personele ATANMIŞ destek talepleri (BAK-98).
  supportRequests       SupportRequest[]     @relation("SupportRequestAssignee")
  /// BAK-129: Bu hesabın Web Push abonelikleri (cihaz/tarayıcı başına bir satır).
  pushSubscriptions     PushSubscription[]

  // Kimlik boş kalamaz (email VEYA username) ve ayrıcalıklı rollerde e-posta
  // zorunludur — ikisi de migration'da CHECK kısıtı olarak DB'de durur; PSL
  // bunları ifade edemediği için burada yalnızca not olarak geçer.
  @@unique([workshopId, username])
  @@index([workshopId])
  @@index([technicianId])
}

// Workshop-scoped team roles. `staff` is the least-privileged operational role.
enum UserRole {
  owner // Yönetici — her şey + kapalı iş emrini yeniden açabilir
  manager // Servis Müdürü — ekip yönetimi + tüm operasyonlar
  usta // Usta — iş emri düzenler, durum ilerletir; ekip/kasa/katalog yönetemez
  cirak // Çırak — parça alır ve maliyet girer; iş emri düzenleyemez
  staff // LEGACY: #183 öncesi kayıtlar. İzin düzeyi `usta` ile aynıdır — mevcut
  // kullanıcılar yetki KAYBETMESİN diye korunur; yeni atama listesinde yoktur.
}

// Token-based team invite. The raw token lives only in the e-mailed URL; we
// store sha256(token) so a DB leak can't reproduce a usable invite link.
model Invite {
  id              String       @id @default(cuid())
  workshopId      String
  workshop        Workshop     @relation(fields: [workshopId], references: [id])
  email           String
  role            UserRole     @default(staff)
  tokenHash       String       @unique
  status          InviteStatus @default(pending)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String?
  createdBy       User?        @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([workshopId, email])
  @@index([workshopId])
  @@index([status])
  @@index([expiresAt])
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Customer {
  id              String              @id @default(cuid())
  workshopId      String
  workshop        Workshop            @relation(fields: [workshopId], references: [id])
  type            CustomerType        @default(individual)
  firstName       String?
  lastName        String?
  fullName        String?
  companyName     String?
  contactName     String?
  phone           String
  phone2          String?
  email           String?
  city            String?
  district        String?
  address         String?
  identityNumber  String?
  taxNumber       String?
  taxOffice       String?
  notes           String?
  tag             CustomerTag?        @default(standard)
  source          CustomerSource?
  priceGroup      CustomerPriceGroup? @default(standard)
  discountRate    Int?                @default(0) // bps (2000 = %20)
  riskNote        String?
  whatsappConsent Boolean             @default(false)
  smsConsent      Boolean             @default(false)
  emailConsent    Boolean             @default(false)
  kvkkApprovedAt  DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  vehicles     Vehicle[]
  intakes      VehicleIntakeForm[]
  quotes       Quote[]
  appointments Appointment[]
  reminders    MaintenanceReminder[]
  collections  CollectionPayment[]

  @@unique([workshopId, phone]) // a phone belongs to a single customer per workshop
  @@index([workshopId])
  @@index([workshopId, type])
}

enum CustomerType {
  individual
  corporate
}

enum CustomerTag {
  standard
  vip
  risky
  fleet
}

enum CustomerSource {
  referral
  google
  social_media
  walk_in
  existing
  other
}

enum CustomerPriceGroup {
  standard
  discounted
  fleet
}

model Vehicle {
  id                    String   @id @default(cuid())
  workshopId            String
  workshop              Workshop @relation(fields: [workshopId], references: [id])
  customerId            String
  customer              Customer @relation(fields: [customerId], references: [id])
  plate                 String
  brand                 String
  model                 String
  vehicleType           String?
  modelYear             Int?
  mileage               Int?
  vin                   String?
  vinOcrRaw             String?
  vinConfirmed          Boolean  @default(false)
  color                 String?
  engineNo              String?
  fuelType              String?
  transmission          String?
  // Ruhsat (vehicle registration) detail fields. Stored as raw strings to
  // preserve the exact ruhsat text (dates as DD.MM.YYYY, displacement/power
  // with units) and avoid OCR/manual parse fragility.
  commercialName        String? // Ticari Adı (ruhsat D.3)
  firstRegistrationDate String? // İlk tescil tarihi
  engineDisplacement    String? // Silindir Hacmi
  enginePower           String? // Motor Gücü
  inspectionValidUntil  String? // Muayene geçerlilik tarihi
  // TecDoc catalog linkage (resolved from VIN or picked manually). Plain Int
  // columns — intentionally NO foreign keys to the catalog tables, because the
  // catalog is re-importable reference data (scripts/migrate-vehicle-catalog.ts)
  // and hard FKs would block re-seeding. Consistency is validated at write time.
  catalogBrandId        Int?
  catalogModelId        Int?
  catalogVehicleTypeId  Int?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  intakes        VehicleIntakeForm[]
  quotes         Quote[]
  appointments   Appointment[]
  reminders      MaintenanceReminder[]
  passportTokens VehiclePassportToken[]

  @@unique([workshopId, plate])
  /// VIN duplicate check is done at application level (not DB unique) because VIN can be null/empty.
  /// Use prisma.vehicle.findFirst({ where: { workshopId, vin } }) for duplicate VIN detection.
  @@index([workshopId])
  @@index([customerId])
  @@index([workshopId, vin])
  /// Servisler arası araç geçmişi (BAK-77) plakayı ATÖLYEDEN BAĞIMSIZ arar.
  /// `@@unique([workshopId, plate])` bu sorguya yaramaz (bileşik indeksin ön eki
  /// workshopId'dir), o yüzden plaka için ayrı bir indeks gerekir.
  @@index([plate])
}

/// Bir atölyenin, BAŞKA atölyelerdeki araç geçmişini maskesiz görme hakkı (BAK-77).
///
/// Hak, aracın **ruhsatının o atölyede okutulmuş olmasıyla** kazanılır: ruhsatı
/// elinde tutmak, araçla gerçek bir servis ilişkisi kurulduğunun kanıtıdır ve
/// KVKK açısından maskeyi kaldırmanın dayanağıdır. Kayıt bilerek **plaka**
/// üzerinden tutulur, bir `Vehicle` id'si üzerinden değil: hak, tarama anında bu
/// atölyede henüz araç kaydı olmadan da doğar (sihirbazın ilk adımı).
///
/// Hakkın ikinci kaynağı olan "bu atölyenin aracı zaten servis etmiş olması"
/// burada TUTULMAZ; o türetilir (bkz. `src/lib/vehicle-history/access.ts`).
model VehicleHistoryGrant {
  id              String   @id @default(cuid())
  workshopId      String
  workshop        Workshop @relation(fields: [workshopId], references: [id])
  /// Normalize plaka (boşluksuz, büyük harf) — atölyeler arası araç anahtarı.
  plate           String
  /// Tarama anındaki VIN, ruhsatta okunabildiyse. Yalnız bilgi amaçlı.
  vin             String?
  grantedByUserId String?
  /// Ruhsat sahipliğini kanıtlayan OcrLog satırı. FK YOK: OcrLog başka bir
  /// saklama politikasına tabi olabilir, temizlenirse hak düşmemeli.
  ocrLogId        String?
  createdAt       DateTime @default(now())

  @@unique([workshopId, plate])
  @@index([workshopId])
  @@index([plate])
}

model VehicleIntakeForm {
  id                  String       @id @default(cuid())
  workshopId          String
  workshop            Workshop     @relation(fields: [workshopId], references: [id])
  customerId          String
  customer            Customer     @relation(fields: [customerId], references: [id])
  vehicleId           String
  vehicle             Vehicle      @relation(fields: [vehicleId], references: [id])
  status              IntakeStatus @default(draft)
  mileageAtIntake     Int?
  /// Kabulde ölçülen yakıt seviyesi. Yüzde olarak saklanır ama yalnızca çeyrek
  /// kademelere izin verilir (0/25/50/75/100); sunum katmanı "1/4", "1/2" gibi
  /// kesirlere çevirir. null = ölçülmedi. Yüzde seçilmesinin sebebi ileride
  /// 1/8 kademeye geçilirse şema değişikliği gerekmemesi.
  fuelLevelAtIntake   Int?
  customerComplaint   String
  internalNote        String?
  /// Aracı servise GETİREN kişi, müşterinin kendisi değilse (#196). Kabulde
  /// doldurulur. null = müşteri aracı kendi getirdi.
  droppedOffByName    String?
  droppedOffByPhone   String?
  /// Aracı TESLİM ALACAK kişi, müşterinin kendisi değilse (#149). Teslimden
  /// önce herhangi bir anda doldurulabilir. null = müşteri kendi teslim alacak.
  pickedUpByName      String?
  pickedUpByPhone     String?
  approvalTextVersion String?
  approvedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  photos         VehiclePhoto[]
  damageMarks    DamageMark[]
  approvals      ApprovalRequest[]
  shareLinks     PublicShareLink[]
  timelineEvents IntakeTimelineEvent[]
  order          ServiceOrder?

  @@index([workshopId])
  @@index([customerId])
  @@index([vehicleId])
}

enum IntakeStatus {
  draft
  waiting_approval
  approved
  in_progress
  ready_for_delivery
  delivered
  cancelled
}

model VehiclePhoto {
  id                 String            @id @default(cuid())
  workshopId         String
  workshop           Workshop          @relation(fields: [workshopId], references: [id])
  intakeFormId       String
  intakeForm         VehicleIntakeForm @relation(fields: [intakeFormId], references: [id])
  serviceOrderId     String?
  serviceOrder       ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  // Dış alım (ServiceOrderItem source=purchase) fotoğrafı bu FK ile bağlanır.
  // null → normal intake/onarım fotoğrafı. Alış fotoları dahili-yalnızdır:
  // public/paylaşım galerileri serviceOrderItemId=null ile filtreler.
  serviceOrderItemId String?
  serviceOrderItem   ServiceOrderItem? @relation(fields: [serviceOrderItemId], references: [id])
  type               VehiclePhotoType
  phase              PhotoPhase        @default(intake)
  label              String
  required           Boolean           @default(false)
  fileUrl            String?
  fileName           String?
  mimeType           String?
  sizeBytes          Int?
  storageProvider    String?
  storageKey         String?
  note               String?
  // Silme SOFT'tur: delil bütünlüğü gereği satır ve depodaki dosya korunur,
  // yalnızca galeriler/PDF/public paylaşım `deletedAt: null` ile filtreler.
  // Kimin sildiği denetim için burada, ayrıntısı AuditLog `photo_deleted`ta.
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?             @relation("VehiclePhotoDeletedBy", fields: [deletedById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([workshopId])
  @@index([intakeFormId])
  @@index([phase])
  @@index([serviceOrderId])
  @@index([serviceOrderItemId])
  @@index([deletedAt])
}

enum VehiclePhotoType {
  front
  rear
  left_side
  right_side
  dashboard_mileage
  fuel_gauge
  registration_front
  registration_back
  vin_area
  damage_detail
  other
}

enum PhotoPhase {
  intake
  repair_progress
  delivery
}

model DamageMark {
  id           String            @id @default(cuid())
  workshopId   String
  workshop     Workshop          @relation(fields: [workshopId], references: [id])
  intakeFormId String
  intakeForm   VehicleIntakeForm @relation(fields: [intakeFormId], references: [id])
  zone         String
  damageType   DamageType
  severity     DamageSeverity
  note         String?
  photoUrl     String?
  createdAt    DateTime          @default(now())

  @@index([workshopId])
  @@index([intakeFormId])
}

enum DamageType {
  scratch
  dent
  broken
  cracked
  paint_damage
  missing_part
  other
}

enum DamageSeverity {
  light
  medium
  heavy
}

model ApprovalRequest {
  id                  String            @id @default(cuid())
  workshopId          String
  workshop            Workshop          @relation(fields: [workshopId], references: [id])
  intakeFormId        String
  intakeForm          VehicleIntakeForm @relation(fields: [intakeFormId], references: [id])
  phone               String
  otpCode             String
  status              ApprovalStatus    @default(pending)
  approvalType        String            @default("vehicle_intake")
  approvalTextVersion String?
  approvedAt          DateTime?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([workshopId])
  @@index([intakeFormId])
}

